# Used by tools/refresh-daybook.mjs and tools/make-widget-data.mjs (set as user environment variables on Windows).
DAYBOOK_VAULT=C:\path\to\your\notes-vault
DAYBOOK_API_URL=https://your-api-site.netlify.app/api
DAYBOOK_KEY=generate-a-long-random-string
NETLIFY_SITE_ID=your-site-name-or-id
NETLIFY_API_SITE_ID=your-api-site-id
# Optional
DAYBOOK_EXCLUDE=insurance
DAYBOOK_OMIT=

# Set on the API site in Netlify (not here):
# DAYBOOK_KEY, DAYBOOK_SITE_URL=https://your-site.netlify.app, DAYBOOK_TZ=America/Toronto,
# TT_CLIENT_ID, TT_CLIENT_SECRET (from developer.ticktick.com)
